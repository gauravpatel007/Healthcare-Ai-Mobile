# =====================================================================
# Comprehensive .gitignore for LifeOS / Healthcare AI Mobile & Backend
# =====================================================================

# ---------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL SECURITY)
# ---------------------------------------------------------------------
.env
.env.*
.env.local
.env.*.local
.env.android
!.env.example

# Secret audit dumps, tokens, private keys & certificates
*secrets*
*secret*.txt
scratch_secrets.txt
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.crt
*.cer
id_rsa
id_ed25519

# Firebase / Service Account Admin credentials (never upload private keys)
*-firebase-adminsdk-*.json
*adminsdk*.json
*firebase-adminsdk*.json

# Android Signing Keystores
*.keystore
*.jks

# ---------------------------------------------------------------------
# 2. Logs, Tunnels & Debug Files
# ---------------------------------------------------------------------
*.log
*.log.*
logs/
*.err
*.out
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tunnel & local server logs (pinggy, localhost.run, etc.)
lh.log
lh2.log
pinggy.log
pinggy2.log
backend/*.log

# Debug dumps and temporary output text files
*debug*.txt
test_out.txt
fitness_debug.txt
backend/fitness_debug.txt
backend/test_out.txt

# ---------------------------------------------------------------------
# 3. Python Virtual Environments & Packages
# ---------------------------------------------------------------------
venv/
venv*/
.venv/
.venv*/
env/
env*/
ENV/
test_venv/
*venv*/
env.bak/
venv.bak/

# Python byte-code & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing, Benchmarks & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.benchmarks/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------
# 4. Node.js & Web Frontend (frontend-react)
# ---------------------------------------------------------------------
node_modules/
frontend-react/node_modules/
dist/
frontend-react/dist/
build/
frontend-react/build/
.pnpm-store/
.npm/

# ---------------------------------------------------------------------
# 5. Mobile & Android Build Artifacts (Capacitor / Gradle)
# ---------------------------------------------------------------------
# Compiled Application Packages & Builds
*.apk
*.aab
*.ap_
*.aar
*.dex
artifacts/
*.apk.idsig

# Gradle caches and build outputs
.gradle/
**/android/.gradle/
**/android/build/
**/android/app/build/
**/android/capacitor-cordova-android-plugins/

# Android Studio & SDK local configurations
local.properties
**/android/local.properties
.navigation/
captures/
.externalNativeBuild/
.cxx/
*.hprof
output.json

# ---------------------------------------------------------------------
# 6. Databases, Backups & Medical User Uploads (HIPAA / Privacy)
# ---------------------------------------------------------------------
# SQLite / Local Databases
*.db
*.db-*
*.sqlite
*.sqlite3
*.db3
*.s3db
*.db-shm
*.db-wal
lifeos.db
backend/lifeos.db

# Database Dumps & SQL exports
*.dump
*.sql
*.sql.gz
*.sql.zip
lifeos_db_dump.dump

# User Uploaded Documents & Media (Prescriptions, Lab Reports, Scans)
uploads/
**/uploads/
data/
**/data/

# ---------------------------------------------------------------------
# 7. Documentation Build Artifacts & Screenshots
# ---------------------------------------------------------------------
# Documentation build outputs & generated binary reports
documentation_build/output/
documentation_build/screenshots/
docs/*.docx
docs/*.pdf
documentation_build/*.docx
documentation_build/*.pdf

# Local device screenshots & screen capture scripts
mobile_screenshots/
capture_moto_screenshots.py
test_db.py

# ---------------------------------------------------------------------
# 8. Scratch Scripts & Archives
# ---------------------------------------------------------------------
scratch/
scratch_*
scratch_*.*
BIN FOLDER/

# Backup and compressed archives
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z
*.bak
*.tmp
*.temp
*.swp
*.swo
*~

# ---------------------------------------------------------------------
# 9. IDE, OS & Editor Settings
# ---------------------------------------------------------------------
.vscode/
.idea/
.history/
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
