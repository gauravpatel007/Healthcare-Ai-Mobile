# ============================================
# LifeOS Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# --- Database ---
DATABASE_URL=postgresql+asyncpg://xxxxxxx@localhost:xxx/lifeos_mobile_db

# --- JWT Authentication ---
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Groq AI ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- File Uploads ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# --- Twilio SMS Service ---
# Local precedence: process environment > backend/.env > root .env.
# Docker Compose uses the root .env / deployment environment. Restart the
# backend after changing credentials; cached settings do not update live.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
# Enable for trials that reject inline TwiML. Voice instructions are sent to
# Twilio's Echo Twimlet in the URL; keep request URLs out of application logs.
TWILIO_VOICE_USE_URL=false
# Set true only for template-only trials; no substitute SMS is sent.
# Set false after the provider enables custom messaging.
TWILIO_SMS_TEMPLATE_ONLY=false

SMTP_EMAIL=
SMTP_PASSWORD=
PUBLIC_API_URL=http://16.171.242.175

# --- Application ---
APP_NAME=LifeOS
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO
